# Copy to .env. Secrets below are only for local development: in production
# they come from Docker Secrets (./secrets/*.txt -> /run/secrets/<name>).

# --- Telegram ---
BOT_TOKEN=
BOT_USERNAME=your_node_bot
ADMIN_TELEGRAM_ID=123456789
# Phone/PC Telegram sessions may view /status; management stays outside Telegram.
ADMIN_TELEGRAM_READ_ONLY=true
BOT_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_DOMAIN=cyberdefency.com
SUPPORT_USERNAME=

# --- HTTP ---
DOMAIN=cyberdefency.com
ACME_EMAIL=admin@example.com
# Must match the actual public web listener; append :8443 if clients use that port.
PUBLIC_BASE_URL=https://cyberdefency.com
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
CORS_ORIGINS=
TRUST_FORWARDED_FOR=true
METRICS_TOKEN=

# --- Storage / logging ---
DATABASE_PATH=data/bot.db
# Ключ SQLCipher — в secrets/db_key.txt (64 hex-символа, создаёт init_secrets.sh)
LOG_LEVEL=INFO
LOG_DIR=logs
CONN_LOG_RETENTION_DAYS=180
# Minimal telemetry; business accounts/payments remain necessary.
ACTIVITY_LOGGING_ENABLED=false

# --- Marzban ---
# HTTPS endpoint reported in the provided Germany/Russia deployment notes.
# Verify reachability and admin-access controls before using in production.
MARZBAN_URL=https://panel.cyberdefency.com:8443
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=
MARZBAN_INBOUND_TAG=VLESS TCP REALITY
MARZBAN_VERIFY_TLS=true

# --- Локации ---
# link: одна vless-ссылка на основной сервер. subscription: ссылка-подписка Marzban
# со всеми серверами (клиент сам обновляет список при добавлении новых).
CONFIG_DELIVERY=subscription
# Публичный адрес подписок Marzban, если панель отдаёт относительный путь /sub/...
SUBSCRIPTION_BASE_URL=https://sub.cyberdefency.com:8443
# Название сервера, на котором работает сама панель (для /servers)
MAIN_LOCATION_NAME=🇩🇪 Германия

# --- AmneziaWG (второй протокол, ключ на каждое устройство) ---
# Включает scripts/install_awg.sh после запуска контейнера cyberdefency-awg.
AWG_ENABLED=false
AWG_AGENT_URL=http://cyberdefency-awg:8090
# Токен агента (32+ символов) записывает install_awg.sh; вручную не задавайте.
AWG_AGENT_TOKEN=

# --- Crypto Pay (@CryptoBot) ---
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_TESTNET=true

# --- Telegram Stars ---
# Правила Telegram: цифровые услуги внутри бота продаются за Stars (XTR).
# Подробно: docs/PAYMENTS_TELEGRAM.md. Счёт и зачисление работают без ключей.
STARS_ENABLED=true
# Сколько рублей считать за 1 звезду при пересчёте цен тарифа (299 ₽ / 1.60 = 187 ⭐).
STARS_RUB_PER_STAR=1.60
# Ежемесячное автопродление через подписку Stars (оферта п. 3.3.1). По умолчанию выключено.
STARS_AUTORENEW_ENABLED=false
# Кнопка оплаты через ЮKassa в боте. Оплата на сайте (PWA) не зависит от этой настройки.
YOOKASSA_IN_BOT=true
# Токен ЮKassa из @BotFather → Payments («ЮKassa: платежи»): оплата прямо в Telegram,
# без ключей REST, вебхука и Cloudflare. Не вписывайте сюда руками — на сервере:
#   bash scripts/update_bot.sh --set-secret TELEGRAM_PAYMENT_TOKEN
TELEGRAM_PAYMENT_TOKEN=

# --- Рубли ---
# yookassa: ЮKassa (СБП и карты). manual: перевод по QR из «Мой налог» и /confirm.
SBP_PROVIDER=yookassa
SBP_QR_URL=https://qr.nspk.ru/REPLACE_WITH_YOUR_QR
SBP_PAYMENT_URL=https://qr.nspk.ru/REPLACE_WITH_YOUR_QR
SBP_PROVIDER_TOKEN=

# --- ЮKassa ---
# shopId из личного кабинета; секретный ключ — в secrets/yookassa_secret_key.txt
YOOKASSA_SHOP_ID=
# self_employed: самозанятый (НПД), чеки в «Мой налог» формирует ЮKassa.
# fiscal: ИП/ООО, чек 54-ФЗ на email покупателя.
YOOKASSA_RECEIPT_MODE=self_employed
# Только для fiscal: 1 = без НДС; 2 = УСН «доходы».
YOOKASSA_VAT_CODE=1
YOOKASSA_TAX_SYSTEM_CODE=2
# Куда вернуть пользователя после оплаты (по умолчанию https://t.me/<BOT_USERNAME>)
YOOKASSA_RETURN_URL=
# Existing direct mode is retained until the private RU gateway is installed.
# For the selected two-server setup merge de-payment-routing.env from
# scripts/render_payment_edge.py. A missing gateway must not fall back to direct.
YOOKASSA_EGRESS=direct
YOOKASSA_PROXY_URL=

# --- Auth ---
# 64 hex chars: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# --- Web Push (python scripts/gen_vapid.py) ---
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_CONTACT=mailto:admin@example.com

# --- Abuse reports from node IDS ---
ABUSE_REPORT_TOKEN=
# Review does not automatically block users based on heuristic signals.
AUTOBAN_MODE=review
TRAFFIC_ANOMALY_GB_PER_DAY=800
AUTOBAN_GB_PER_DAY=2000
# Monthly traffic of the hosting plan, decimal GB (0 = off). The bot forecasts
# the month and warns the owner. Owner: /traffic.
SERVER_TRAFFIC_LIMIT_GB=5000
# What the provider counts: both (in + out), out or in. See the hosting plan.
SERVER_TRAFFIC_COUNTS=both
SERVER_TRAFFIC_RESET_DAY=1
# Pause new trials at 90 % of the allowance. First amend clause 1.6 of the
# offer: docs/SERVER_MAINTENANCE.md.
SERVER_TRAFFIC_PAUSE_TRIALS=false

# --- Business ---
TRIAL_SECONDS=86400
# Лимит трафика пробного периода в ГБ (0 = без ограничения).
TRIAL_TRAFFIC_GB=3
# New referral acquisition is off. Existing earned/referred rewards are preserved.
REFERRAL_ACQUISITION_ENABLED=false
REFERRAL_INVITER_BONUS_DAYS=15
REFERRAL_INVITEE_BONUS_DAYS=3

# --- Backups (scripts/backup.sh) ---
BACKUP_GPG_RECIPIENT=admin@example.com
BACKUP_RETENTION_DAYS=30

# Тарифы в продаже (через запятую): standard, basic, complete, prime.
# standard — 1–6 мес., до 2 устройств, 200 ГБ на 30 дней (новая модель).
# Первый в списке тариф используется для пробного периода и ссылок без тарифа.
# Если переменная не задана, остаются прежние basic,complete,prime.
ENABLED_TIERS=standard

# Прокси для вызовов Telegram Bot API. Нужен боту в РФ, где api.telegram.org
# недоступен: HTTP CONNECT-прокси за пределами РФ, который пускает только
# api.telegram.org:443 и только с IP бота. Пусто — прямое соединение.
TELEGRAM_PROXY_URL=
